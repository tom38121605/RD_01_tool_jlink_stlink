38); cursor: pointer; }

.waterfall .auth { padding: 0px 10px 10px; border-width: 0px 1px 1px; borde=
r-style: solid; border-color: transparent rgb(234, 234, 234) rgb(185, 185, =
185); background: rgb(248, 248, 248); }

.waterfall .auth img { display: inline-block; margin: 0px 1px; }

.pgbtn { margin: 5px 0px 10px; }

.pgbtn a { display: block; height: 40px; line-height: 40px; letter-spacing:=
 5px; text-align: center; border: 1px solid rgb(220, 220, 220); font-size: =
14px; outline: none; border-radius: 5px; box-shadow: rgb(245, 245, 245) 0px=
 1px 0px; }

.pgbtn a:hover { border-color: rgb(186, 186, 186); text-decoration: none; }

