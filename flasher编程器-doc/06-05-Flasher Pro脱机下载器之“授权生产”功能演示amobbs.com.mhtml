ackground: rgb(187, 187, 187); }

.waterfall { position: relative; margin-top: 15px; }

.waterfall li { margin: 0px 10px 10px 0px; padding: 0px 0px 3px; text-align=
: left; border-width: 1px 0px 0px; border-top-style: solid; border-top-colo=
r: rgb(234, 234, 234); background: url("https://www.amobbs.com/static/image=
/common/bg_waterfall.png") 100% 100% no-repeat; }

.waterfall .c, .waterfall h3 { padding: 10px; border-style: solid; border-c=
olor: rgb(234, 234, 234); border-image: initial; border-width: 0px 1px; bac=
kground-color: rgb(248, 248, 248); }

.waterfall .c { overflow: hidden; padding-bottom: 0px; max-height: 800px; }

.waterfall .c .nopic { display: block; background: url("https://www.amobbs.=
